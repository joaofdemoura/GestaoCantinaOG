<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Carrinho" android:textSize="30sp" android:gravity="center" />
            <TextView android:id="@+id/nomeCarrinho" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:textSize="20sp" />
            <TextView android:id="@+id/totalCarrinho" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:textSize="22sp" />
            <Button android:id="@+id/btnLimparCarrinho" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Limpar carrinho" />
            <Button android:id="@+id/btn_Finalizar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Finalizar pedido" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
