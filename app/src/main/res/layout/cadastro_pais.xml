<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".cadastro_pais">

    <ScrollView
        android:layout_width="409dp"
        android:layout_height="729dp"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Space
                android:layout_width="match_parent"
                android:layout_height="91dp" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="50px"
                android:text="Cadastre-se"
                android:textAlignment="center"
                android:textSize="30sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="28dp" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="355dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="50px"
                android:text="CPF"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/et_cpf"
                android:layout_width="353dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="50px"
                android:ems="10"
                android:hint="Digite seu cpf"
                android:inputType="text" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="36dp" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="358dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="50px"
                android:text="Nome"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/et_userpai"
                android:layout_width="358dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="50px"
                android:ems="10"
                android:hint="Digite seu nome"
                android:inputType="text" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="38dp" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="360dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="50px"
                android:text="Senha"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/et_senha"
                android:layout_width="362dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="50px"
                android:ems="10"
                android:hint="Digite sua senha"
                android:inputType="text|textPassword" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="35dp" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="365dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="50px"
                android:text="CPF de seu filho"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/et_cpfFilho"
                android:layout_width="365dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="50px"
                android:ems="10"
                android:hint="Digite o cpf de seu filho"
                android:inputType="text" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="14dp" />

            <Button
                android:id="@+id/bnt_cadastrar"
                android:layout_width="317dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:backgroundTint="#FF0505"
                android:padding="50px"
                android:text="Cadastrar" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>