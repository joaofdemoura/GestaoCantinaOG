<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".extrato">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Título -->

            <TextView
                android:id="@+id/tituloExtrato"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Extrato"
                android:textSize="30sp"
                android:textStyle="bold" />

            <!-- PEDIDO 1 -->

            <LinearLayout
                android:id="@+id/pedido1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:background="#EEEEEE"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Número do pedido -->

                <TextView
                    android:id="@+id/numeroPedido1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pedido nº 001"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Produtos -->

                <TextView
                    android:id="@+id/produtosPedido1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="1x Produto 1&#10;1x Produto 2"
                    android:textSize="17sp" />

                <!-- Valor -->

                <TextView
                    android:id="@+id/valorPedido1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Valor: R$ 25,00"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Horário -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Horário do recreio:"
                    android:textSize="16sp" />

                <Spinner
                    android:id="@+id/spinnerHorario1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" />

            </LinearLayout>

            <!-- PEDIDO 2 -->

            <LinearLayout
                android:id="@+id/pedido2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="#EEEEEE"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/numeroPedido2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pedido nº 002"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/produtosPedido2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="2x Produto 1"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/valorPedido2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Valor: R$ 20,00"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Horário do recreio:"
                    android:textSize="16sp" />

                <Spinner
                    android:id="@+id/spinnerHorario2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" />

            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="119dp" />

            <Button
                android:id="@+id/bnt_voltar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FF0000"
                android:text="Voltar" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>